=== exemption-reach-lifted ===
export const EXCLUDED_ROUTES: Readonly<Record<string, string>> = {};
export function check(
  root: string,
  excused: Readonly<Record<string, string>> = EXCLUDED_ROUTES,
): string[] {
  return [root, ...Object.keys(excused)];
}

=== w295-skip-list-exemption ===
export const W295_SKIPPED: readonly string[] = ["a"];
export function w295Check(
  root: string,
  skipped: readonly string[] = W295_SKIPPED,
): string[] {
  return [root].filter((r) => !skipped.includes(r));
}

