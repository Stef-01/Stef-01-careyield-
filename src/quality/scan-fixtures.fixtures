=== private-tree-recursion ===
// W341: a planted module holding its own copy of the tree recursion.
import { readdirSync, statSync } from "node:fs";
export function everyFile(dir: string): string[] {
  return readdirSync(dir).flatMap((entry) => {
    const full = `${dir}/${entry}`;
    return statSync(full).isDirectory() ? everyFile(full) : [full];
  });
}

=== private-ledger-parse ===
// W341: a planted module holding its own copy of the ledger row parse.
import { readFileSync } from "node:fs";
export function doneUnits(root: string): string[] {
  return readFileSync(`${root}/BUILD-STATE.md`, "utf8")
    .split("\n")
    .flatMap((line) => {
      const m = /^\| (W\d+) \| done \|/.exec(line);
      return m ? [m[1]!] : [];
    });
}

